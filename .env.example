DISCORD_BOT_TOKEN=
GUILD_ID=
# Long random secret, keep it private and never change it (otherwise pseudonyms change).
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
PSEUDO_SALT=

# Right to object: Discord ids of members who asked to be excluded, comma-separated.
# Their messages and member data are removed from the cache and the deliverable.
EXCLUDED_USER_IDS=
# Channel or category ids never exported, comma-separated (a category excludes its channels and threads).
EXCLUDED_CHANNELS=

# Roles held by fewer members than this are grouped as "autre" (they would identify someone).
ROLE_MIN_MEMBERS=5
# Roles always kept by name or id even if rare, comma-separated (e.g. local groups).
ROLES_ALWAYS_KEEP=
